{
  "name": "toolbox",
  "private": true,
  "version": "2.0.0-alpha.1",
  "description": "Self-hosted, multi-tenant AI study platform built around portable learning Kits, FSRS-6 spaced repetition, and hybrid local search.",
  "type": "module",
  "license": "MIT",
  "author": "Arvind Arikatla",
  "keywords": [
    "education",
    "spaced-repetition",
    "fsrs",
    "active-learning",
    "knowledge-graph",
    "self-hosted",
    "local-first",
    "mcp",
    "sqlite",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arvarik/toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/arvarik/toolbox/issues"
  },
  "homepage": "https://github.com/arvarik/toolbox#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "reset-password": "node scripts/reset-password.ts",
    "lint": "oxlint && tsc --noEmit && npm run lint:tenant",
    "lint:js": "oxlint",
    "lint:types": "tsc --noEmit",
    "lint:tenant": "node scripts/tenant-lint.mjs --strict \"server/**/*.ts\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@dagrejs/dagre": "^3.1.1",
    "@huggingface/transformers": "^4.3.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@xyflow/react": "^12.11.3",
    "ai": "^7.0.66",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "katex": "^0.19.1",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.4.0",
    "openid-client": "^6.8.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "sqlite-vec": "^0.1.9",
    "unpdf": "^2.1.0",
    "zod": "^4.6.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.92.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.0.12",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "katex": "^0.19.1"
  }
}
