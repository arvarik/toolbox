# Server bind & storage
PORT=3100
HOST=0.0.0.0
DATA_DIR=./data
DB_PATH=./data/toolbox.db

# Encryption key for credentials at rest (32-byte hex or base64).
# If unset, Toolbox auto-generates and persists ${DATA_DIR}/secret.key.
TOOLBOX_SECRET_KEY=

# Multi-tenant auth & reverse proxy
# false = implicit local owner (local@toolbox.local) until an account is created
AUTH_REQUIRED=false
# Canonical origin (e.g. https://toolbox.example.com) — required for Passkeys & OIDC behind a proxy
PUBLIC_URL=
# Number of trusted reverse-proxy hops for X-Forwarded-For / X-Forwarded-Proto (0-10)
TRUST_PROXY_HOPS=0
# Optional comma-separated hostnames or .domain suffixes for DNS-rebinding protection
# ALLOWED_HOSTS=
# Optional trusted web origin allowed to call POST /api/mcp from a browser
# CORS_ORIGIN=

# Instance AI provider keys (can also be configured in Settings UI or per-user via BYOK)
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Self-hosted SearXNG instance URL for grounded web research (e.g. http://searxng:8080)
SEARXNG_URL=

# Local ONNX embeddings cache & offline mode
# MODELS_DIR=./data/models
# TRANSFORMERS_OFFLINE=1

# Optional OIDC Single Sign-On (can also be configured in Instance Admin UI)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Single Sign-On
# OIDC_MATCH_BY_EMAIL=false

# Optional SMTP mail (invitations, magic links, password resets) & automated SQLite backups
# SMTP_URL=
# MAIL_FROM=
# MAIL_REPLY_TO=
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
