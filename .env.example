# Copy to .env. `npm start` and `npm run dev` read it on startup.
# Docker Compose also passes this file to the container. Its `environment:`
# values win. docs/deployment.md describes every variable.

# Server bind & storage
PORT=3100
# 127.0.0.1 accepts local connections only. To accept other machines, use
# 0.0.0.0 and set AUTH_REQUIRED=true.
HOST=127.0.0.1
DATA_DIR=./data
# DB_PATH defaults to ${DATA_DIR}/toolbox.db
# DB_PATH=./data/toolbox.db

# Encryption key for credentials at rest: 64 hex characters (openssl rand -hex 32).
# If unset, Toolbox auto-generates and persists ${DATA_DIR}/secret.key.
TOOLBOX_SECRET_KEY=

# Multi-tenant auth & reverse proxy
# false = implicit local owner (local@toolbox.local) until an account is created
AUTH_REQUIRED=false
# Canonical origin (e.g. https://toolbox.example.com) — required for Passkeys & OIDC behind a proxy
PUBLIC_URL=
# Number of trusted reverse-proxy hops for X-Forwarded-For / X-Forwarded-Proto (0-10)
TRUST_PROXY_HOPS=0
# Optional comma-separated hostnames or .domain suffixes for DNS-rebinding protection
# ALLOWED_HOSTS=
# Optional trusted web origin allowed to call POST /api/mcp from a browser
# CORS_ORIGIN=

# Instance AI provider keys (can also be configured in Settings UI or per-user via BYOK)
GEMINI_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=
# true lets every user, not only admins, add AI endpoints on private network
# addresses (for example a LAN Ollama server). Use only if you trust every account.
# ALLOW_PRIVATE_BYOK_ENDPOINTS=false

# Self-hosted SearXNG instance URL for grounded web research (e.g. http://searxng:8080)
SEARXNG_URL=

# Local ONNX embeddings cache & offline mode
# MODELS_DIR=./data/models
# TRANSFORMERS_OFFLINE=1

# Optional OIDC Single Sign-On (can also be configured in Instance Admin UI)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Single Sign-On
# OIDC_MATCH_BY_EMAIL=false
# OIDC_ALLOW_PRIVATE=false

# Optional SMTP mail for invitations (reset, sign-in, and email-change links
# point to pages the web app does not have yet)
# SMTP_URL=
# MAIL_FROM=
# MAIL_REPLY_TO=

# Automatic SQLite backups in ${DATA_DIR}/backups. Hours between backups
# (0-168, default 24, 0 turns them off) and the number to keep (1-50, default 7)
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
